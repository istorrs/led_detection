{
    "_comment": "Field definitions for AED parameters used in LED detection algorithm",
    "field_definitions": {
        "id": "Integer identifier passed as command line argument to analysis tool",
        "name": "Human readable model name of the AED",
        "params": {
            "pixel_threshold": "Minimum pixel intensity change required to consider a pixel 'changed'. Range 0-255.",
            "pixel_threshold_max": "Maximum pixel intensity change allowed. Usually 2147483647 (disabled).",
            "binary_threshold": "Threshold for binary mask generation. Pixels above this are counted.",
            "blink_period_seconds": "Expected time in seconds between LED pulses. -1 indicates unknown/aperiodic.",
            "blink_period_margin_percent": "Allowed deviation (%) from the blink_period_seconds for a valid repetition.",
            "blink_frames_max": "Maximum duration (in frames @ 30fps) a single pulse can last.",
            "blink_frames_min": "Minimum duration (in frames @ 30fps) a single pulse must last."
        }
    },
